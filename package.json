{
    "private": true,
    "type": "module",
    "main": ".next/standalone/server.js",
    "scripts": {
        "dev": "next dev",
        "build": "next build && node -e \"require('fs').cpSync('public', '.next/standalone/public', {recursive: true});require('fs').cpSync('.next/static', '.next/standalone/public/_next/static', {recursive: true})\" && rolldown -c rolldown.config.mjs",
        "start": "node .",
        "postinstall": "(copy-env-cli || true) && (prisma generate || true)",
        "typecheck": "tsc --noEmit",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "openapi:generate": "NODE_OPTIONS='--conditions react-server' tsx node_modules/next-rest-framework/dist/cli/index.js generate"
    },
    "dependencies": {
        "@exodus/bytes": "^1.16.0",
        "@heroui/react": "^3.2.6",
        "@heroui/styles": "^3.2.6",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "@t3-oss/env-core": "^0.13.11",
        "@t3-oss/env-nextjs": "^0.13.11",
        "clsx": "^2.1.1",
        "cookies-next": "^6.1.1",
        "dotenv": "^17.4.2",
        "gammait": "^1.1.0",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^1.57.0",
        "next": "^16.4.1",
        "next-rest-framework": "^6.1.1",
        "pdf-parse": "^2.4.5",
        "pg": "^8.23.1",
        "prisma": "7.10.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "zod": "^4.6.7",
        "zod-form-data": "^3.0.4"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.19.2",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "copy-env-cli": "^1.0.0",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "postcss": "^8.5.30",
        "rolldown": "^1.2.14",
        "server-only": "^0.0.1",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.24.0",
            "onFail": "warn"
        },
        "runtime": {
            "name": "node",
            "version": "^24.19.0",
            "onFail": "error"
        }
    },
    "packageManager": "pnpm@11.24.0"
}
